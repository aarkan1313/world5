# W5 .gitignore
# Strategy: track source + configs + docs + schemas + small assets.
# Ignore generated content, caches, model weights, OS noise.

# ============ Python ============
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.pytest_tmp/
*.egg-info/
build/
dist/
.tox/
.coverage
.coverage.*
htmlcov/

# ============ Godot project caches ============
demo/.godot/
demo/.import/
engine/.godot/
engine/.import/
**/.import/
*.import.tmp

# ============ Content addressing store (spec 12) ============
# Per-machine bake cache; regenerable. Never commit.
pipeline/.content_addressed_store/
pipeline/_gpu_lock/

# ============ Model weights / checkpoints ============
# Track via download URL + content addressing, not in git.
*.safetensors
*.ckpt
*.bin
*.gguf
*.onnx
*.pt
*.pth
*.npz
*.npy
*.pkl

# ============ Heavy media (generated by pipeline) ============
# Small reference PNGs in examples/ are OK; large generated outputs are not.
*.tif
*.tiff
*.webm
*.mp4
*.mov
*.wav
*.flac
*.mp3
*.exr
*.hdr
# .glb / .gltf are TRACKED in engine/decoration_meshes/, foliage_meshes/,
# cave_meshes/ (those are shipped assets per spec 04 allowlist).
# Untracked .glb elsewhere:
pipeline/**/*.glb
subjects_3d/**/*.glb

# Generated texture candidates (regenerated by pipeline)
pipeline/textures/candidates/
pipeline/textures/output/
pipeline/textures/cache/

# Generated decoration blobs (regenerated by pipeline)
**/decorations/*.bin

# Generated nav export blobs (regenerated by pipeline)
**/nav_chunks/*.npz

# DEM source data (consumer-supplied; not engine asset)
**/dem/

# ============ Secrets / env ============
*.env
.env.*
**/credentials.json
**/secrets.json
hf_*

# ============ OS / editor noise ============
.DS_Store
Thumbs.db
*.swp
*~
*.log

# ============ Temp / scratch ============
**/tmp/
**/_scratch/
**/_to_delete/

# ============ Forkability validation scratch (lives outside repo) ============
# Per spec 44, forks live at D:/tmp/w5_forks/ during validation; not in tree.

# ============ Per-machine dev-time addon link ============
# demo/addons/world5/ is a per-dev-machine symlink/junction to ../../engine/.
# Each contributor creates their own via setup.py (Phase 2). Not committed.
demo/addons/world5/
demo/addons/world5

# ============ Pre-existing user scratch (not part of W5 Phase 0) ============
# worldgen5/ predates this scaffold. Investigated, not deleted. Excluded
# from W5 git tracking since it's a separate user-created Godot scratch.
worldgen5/

# ============ Local Claude state ============
.claude/
